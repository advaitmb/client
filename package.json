{
  "name": "gingko-writer",
  "productName": "Gingko Writer",
  "version": "2.5.0",
  "description": "Gingko client rewritten in Elm.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/advaitmb/client.git"
  },
  "author": {
    "name": "Gingko Inc",
    "email": "adriano@gingkowriter.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/advaitmb/client/issues"
  },
  "homepage": "https://github.com/advaitmb/client",
  "scripts": {
    "test": "bun run test:elm && bun run test:ts",
    "test:elm": "ELM_HOME=$PWD/elm-home/elm-stuff elm-test",
    "test:ts": "bun test",
    "typecheck": "tsc -p src/ui/tsconfig.json",
    "config-check": "bun config-check.js",
    "newbuild": "bun patches.mjs && bun esbuild.mjs && cp -r src/static/. web/ && bunx tailwindcss -i src/static/style.css -o web/style.css && ELM_HOME=elm-home/elm-stuff elm-watch make --optimize && bun run minifyelm",
    "minifyelm": "bunx uglifyjs web/elm.js --compress 'pure_funcs=[F2,F3,F4,F5,F6,F7,F8,F9,A2,A3,A4,A5,A6,A7,A8,A9],pure_getters,keep_fargs=false,unsafe_comps,unsafe' | bunx uglifyjs --mangle --output web/elm.js"
  },
  "dependencies": {
    "@tpp/hybrid-logical-clock": "^1.0.0",
    "@tpp/simple-uuid": "^1.0.0",
    "dexie": "^3.2.2",
    "dexie-export-import": "^1.0.3",
    "dompurify": "^3.4.14",
    "gsap": "^3.11.3",
    "immortal-db": "^1.1.0",
    "lodash": "^4.17.15",
    "marked": "^18.0.11",
    "mousetrap": "^1.6.1",
    "platform": "^1.3.6",
    "pws": "^7.0.0",
    "screenfull": "^5.1.0"
  },
  "trustedDependencies": [
    "elm"
  ],
  "devDependencies": {
    "autoprefixer": "^10.4.14",
    "elm": "^0.19.1-3",
    "elm-test": "0.19.1-revision12",
    "elm-watch": "^1.1.2",
    "esbuild": "^0.20.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.25",
    "tailwindcss": "^3.3.2",
    "typescript": "~5.9.3",
    "uglify-js": "^3.17.4"
  }
}
